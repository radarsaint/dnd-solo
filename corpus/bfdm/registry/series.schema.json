{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radarsaint/bfdm-corpus/registry/series.schema.json",
  "title": "BFDM campaign/project series registry record",
  "type": "object",
  "required": [
    "series_id",
    "canonical_name",
    "aliases",
    "project_ids",
    "known_activity_window",
    "scale_context",
    "uncertainties",
    "support_refs"
  ],
  "properties": {
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array"
    },
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "known_activity_window": {
      "type": "object"
    },
    "scale_context": {
      "type": "object"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "support_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
